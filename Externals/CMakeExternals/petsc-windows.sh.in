#!/bin/bash
# Configure, build and install PETSc on Windows with MSVC (cl), MS-MPI and
# OpenBLAS, with the external packages of Docker/ubuntu/dockerfile. Generated by
# Externals/CMakeExternals/PETSc.cmake; run with Cygwin bash from a Visual
# Studio x64 developer environment.
#
# Packages that PETSc can download and build on Windows (SuperLU, ML) are
# downloaded. The others are built by the superbuild and passed in. Fortran code
# (MUMPS) is compiled with LLVM Flang through the flang-cygwin wrapper, since
# PETSc's win32fe wrappers do not support Flang. The Flang runtime libraries are
# specified explicitly, because PETSc cannot detect them from the Flang link line.
set -e
# The MS-MPI SDK path contains a space, use its short name
MSMPI_INC=$(cygpath -u "$(cygpath -ms "@CYG_MSMPI_INCLUDE@")")
MSMPI_LIB=$(cygpath -u "$(cygpath -ms "@CYG_MSMPI_LIB@")")
MSMPI_BIN="@CYG_MSMPI_BIN@"
FLANG_LIB="@CYG_FLANG_LIB@"
SS="@CYG_SuiteSparse@/lib"
# Configure runs test programs, which need the MPI and OpenBLAS DLLs
export PATH="$MSMPI_BIN:@CYG_OpenBLAS@/bin:$PATH"
cd "@CYG_PETSC_SRC@"
./configure --force \
  --prefix="@CYG_PETSC_PREFIX@" \
  --with-cc=cl --with-cxx=cl --with-fc=flang-cygwin \
  --with-fortran-bindings=0 \
  --with-fortranlib-autodetect=0 \
  "LIBS=$FLANG_LIB/FortranRuntime.dynamic.lib $FLANG_LIB/FortranDecimal.dynamic.lib $FLANG_LIB/clang_rt.builtins.lib" \
  --with-shared-libraries=0 \
  --with-debugging=0 \
  --with-precision=double \
  --with-strict-petscerrorcode \
  'CFLAGS=-GF -MD -wd4996 -Zc:preprocessor' \
  'COPTFLAGS=-O2' \
  'CXXFLAGS=-GF -MD -GR -EHsc -wd4996 -Zc:preprocessor' \
  'CXXOPTFLAGS=-O2' \
  'FFLAGS=-fms-runtime-lib=dll' \
  'FOPTFLAGS=-O2' \
  "--with-mpi-include=[$MSMPI_INC,$MSMPI_INC/x64]" \
  "--with-mpi-lib=[$MSMPI_LIB/msmpi.lib,$MSMPI_LIB/msmpifec.lib]" \
  --with-mpiexec="$MSMPI_BIN/mpiexec" \
  --with-blaslapack-lib="@CYG_OpenBLAS@/lib/libopenblas.lib" \
  --known-64-bit-blas-indices=0 \
  --with-metis-include="@CYG_METIS@/include" \
  --with-metis-lib="@CYG_METIS@/lib/metis.lib" \
  --with-parmetis-include="@CYG_ParMETIS@/include" \
  --with-parmetis-lib="@CYG_ParMETIS@/lib/parmetis.lib" \
  --download-superlu \
  --download-ml \
  "--download-ml-cmake-arguments=-DMPI_USE_COMPILER_WRAPPERS=OFF -DTPL_MPI_INCLUDE_DIRS=$MSMPI_INC -DTPL_MPI_LIBRARIES=$MSMPI_LIB/msmpi.lib" \
  --with-superlu_dist-include="@CYG_SuperLU_DIST@/include" \
  --with-superlu_dist-lib="@CYG_SuperLU_DIST@/lib/superlu_dist.lib" \
  --with-eigen-include="@CYG_Eigen@" \
  "--with-hypre-include=[@CYG_HYPRE@/include,$MSMPI_INC]" \
  --with-hypre-lib="@CYG_HYPRE@/lib/HYPRE.lib" \
  --with-suitesparse-include="@CYG_SuiteSparse@/include/suitesparse" \
  "--with-suitesparse-lib=[$SS/spqr_static.lib,$SS/umfpack_static.lib,$SS/klu_static.lib,$SS/klu_cholmod_static.lib,$SS/cholmod_static.lib,$SS/btf_static.lib,$SS/ccolamd_static.lib,$SS/colamd_static.lib,$SS/camd_static.lib,$SS/amd_static.lib,$SS/suitesparseconfig_static.lib]" \
  "--with-scalapack-lib=[@CYG_ScaLAPACK@/lib/scalapack-F.lib,@CYG_ScaLAPACK@/lib/scalapack.lib]" \
  --download-mumps="@CYG_MUMPS_PACKAGE@"
make PETSC_DIR="@CYG_PETSC_SRC@" PETSC_ARCH=arch-mswin-c-opt all
make PETSC_DIR="@CYG_PETSC_SRC@" PETSC_ARCH=arch-mswin-c-opt install
