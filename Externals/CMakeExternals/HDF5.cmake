# HDF5 with parallel (MPI) support (options as in Docker/ubuntu/dockerfile,
# without the compression filters)
set(proj HDF5)

sv_externals_enabled_depends(_deps MSMPI)

ExternalProject_Add(${proj}
  PREFIX ${SV_EXTERNALS_TOPLEVEL_BLD_DIR}/${proj}
  URL ${SV_EXTERNALS_HDF5_URL}
  URL_HASH SHA256=${SV_EXTERNALS_HDF5_SHA256}
  DOWNLOAD_DIR ${SV_EXTERNALS_DOWNLOAD_DIR}
  CMAKE_COMMAND ${SV_EXTERNALS_CMAKE_COMMAND}
  CMAKE_CACHE_ARGS
    ${SV_EXTERNALS_COMMON_CMAKE_CACHE_ARGS}
    -DCMAKE_INSTALL_PREFIX:PATH=${SV_EXTERNALS_HDF5_INSTALL_DIR}
    -DBUILD_STATIC_LIBS:BOOL=ON
    -DHDF5_ENABLE_PARALLEL:BOOL=ON
    -DHDF5_ALLOW_UNSUPPORTED:BOOL=ON
    -DHDF5_BUILD_FORTRAN:BOOL=OFF
    -DHDF5_BUILD_JAVA:BOOL=OFF
    -DHDF5_BUILD_CPP_LIB:BOOL=OFF
    -DHDF5_BUILD_EXAMPLES:BOOL=OFF
    -DHDF5_BUILD_TOOLS:BOOL=OFF
    -DHDF5_BUILD_UTILS:BOOL=OFF
    -DHDF5_ENABLE_NONSTANDARD_FEATURE_FLOAT16:BOOL=OFF
    -DHDF5_ENABLE_ZLIB_SUPPORT:BOOL=OFF
    -DHDF5_ENABLE_SZIP_SUPPORT:BOOL=OFF
  DEPENDS ${_deps}
  )
