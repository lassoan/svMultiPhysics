# SuiteSparse: the components and options that PETSc's --download-suitesparse
# uses (PETSc cannot download it when using Microsoft compilers)
set(proj SuiteSparse)

sv_externals_enabled_depends(_deps OpenBLAS)

ExternalProject_Add(${proj}
  PREFIX ${SV_EXTERNALS_TOPLEVEL_BLD_DIR}/${proj}
  URL ${SV_EXTERNALS_SuiteSparse_URL}
  URL_HASH SHA256=${SV_EXTERNALS_SuiteSparse_SHA256}
  DOWNLOAD_DIR ${SV_EXTERNALS_DOWNLOAD_DIR}
  CMAKE_CACHE_ARGS
    ${SV_EXTERNALS_COMMON_CMAKE_CACHE_ARGS}
    -DCMAKE_INSTALL_PREFIX:PATH=${SV_EXTERNALS_SuiteSparse_INSTALL_DIR}
    -DCMAKE_INSTALL_LIBDIR:STRING=lib
    -DBUILD_STATIC_LIBS:BOOL=ON
    -DSUITESPARSE_ENABLE_PROJECTS:STRING=amd$<SEMICOLON>cholmod$<SEMICOLON>klu$<SEMICOLON>umfpack$<SEMICOLON>spqr
    -DBLA_VENDOR:STRING=Generic
    -DBLAS_LIBRARIES:STRING=${SV_EXTERNALS_BLAS_LAPACK_LIBRARIES}
    -DLAPACK_LIBRARIES:STRING=${SV_EXTERNALS_BLAS_LAPACK_LIBRARIES}
    -DSUITESPARSE_USE_CUDA:BOOL=OFF
    -DSUITESPARSE_USE_OPENMP:BOOL=OFF
    -DSUITESPARSE_USE_64BIT_BLAS:BOOL=OFF
    -DSUITESPARSE_USE_FORTRAN:BOOL=OFF
    -DSUITESPARSE_DEMOS:BOOL=OFF
  DEPENDS ${_deps}
  )
